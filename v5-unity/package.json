  "scripts": {
    "start": "py -3.10 bottle_server.py",
    "py3start": "python3 bottle_server.py",
    "webpack": "webpack --devtool source-map --progress  --watch | node -e \"require('readline').createInterface({input:process.stdin}).on('line',l=>console.log('['+new Date().toLocaleTimeString()+']',l))\"",
    "production-build": "rm -f build/* && webpack && python add_cache_busting_query_strings.py",
    "sass": "sass css/nord-theme.scss:css/nord-theme.css --watch",
    "sass:build": "sass css/nord-theme.scss:css/nord-theme.css --style compressed"
  },
  "dependencies": {
    "ace-builds": "^1.41.0",
    "fs-extra": "^6.0.1",
    "json-stable-stringify": "^1.0.1",
    "nord": "^0.2.1",
    "on-build-webpack": "^0.1.0",
    "pixelmatch": "^4.0.2",
    "puppeteer": "^22.3.0",
    "script-loader": ""
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "css-loader": "^7.1.2",
    "sass": "^1.88.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5",
    "url-loader": "^4.1.1",
    "webpack": "^5.82.0",
    "webpack-cli": "^6.0.1"
  }
